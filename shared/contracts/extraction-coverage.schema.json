{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/uar/extraction-coverage.schema.json",
  "title": "Unity accessibility reconnaissance extraction coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildFingerprintId", "declaredScope", "families", "firstSliceFamilies", "replay"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "buildFingerprintId": { "type": "string", "minLength": 1 },
    "declaredScope": { "type": "string", "minLength": 1 },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["familyId", "discovered", "extracted", "excluded", "unsupported", "failed", "notPresent", "blockingGaps"],
        "properties": {
          "familyId": { "type": "string", "minLength": 1 },
          "discovered": { "type": "integer", "minimum": 0 },
          "extracted": { "type": "integer", "minimum": 0 },
          "excluded": { "type": "integer", "minimum": 0 },
          "unsupported": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "notPresent": { "type": "integer", "minimum": 0 },
          "blockingGaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "firstSliceFamilies": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "equivalent", "canonicalDigest"],
      "properties": {
        "performed": { "type": "boolean" },
        "equivalent": { "type": ["boolean", "null"] },
        "canonicalDigest": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
      }
    }
  }
}
