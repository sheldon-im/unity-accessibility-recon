{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/uar/runtime-surface-observation.schema.json",
  "title": "Runtime surface observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildFingerprintId",
    "runId",
    "sceneName",
    "surfaceGeneration",
    "surfaceOwnerIdentity",
    "modalDepth",
    "controlIdentity",
    "role",
    "label",
    "labelSource",
    "value",
    "state",
    "interactable",
    "requirement",
    "actionFamily",
    "privacyClass",
    "coverageGate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "buildFingerprintId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sceneName": { "type": "string", "minLength": 1 },
    "surfaceGeneration": { "type": "integer", "minimum": 0 },
    "surfaceOwnerIdentity": { "type": "string", "minLength": 1 },
    "modalDepth": { "type": "integer", "minimum": 0 },
    "controlIdentity": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "label": { "type": ["string", "null"] },
    "labelSource": { "enum": ["game-localization", "rendered-text", "semantic-owner", "associated-label", "diagnostic-object-name", "unresolved"] },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "state": { "type": ["string", "null"] },
    "interactable": { "type": "boolean" },
    "requirement": { "enum": ["required", "optional", "excluded"] },
    "actionFamily": { "type": "string", "minLength": 1 },
    "privacyClass": { "enum": ["public", "local", "sensitive", "proprietary", "unknown"] },
    "coverageGate": { "enum": ["RUNTIME-OWNER-OBSERVED", "ACTIVE-CONTROLS-INVENTORIED", "SEMANTIC-MODELED", "NATIVE-FOCUS-PROVEN", "NATIVE-ACTION-POSTCONDITION-PROVEN", "NVDA-MANUAL-CONFIRMED", "COVERAGE-CLOSED"] }
  }
}
