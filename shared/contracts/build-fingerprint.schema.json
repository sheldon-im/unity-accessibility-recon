{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/uar/build-fingerprint.schema.json",
  "title": "Unity accessibility reconnaissance build fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fingerprintId",
    "productId",
    "buildId",
    "productVersion",
    "unityVersion",
    "scriptingBackend",
    "architecture",
    "loaderCandidate",
    "keySourceHashes",
    "sourceManifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fingerprintId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "productId": { "type": "string", "minLength": 1 },
    "buildId": { "type": "string", "minLength": 1 },
    "productVersion": { "type": "string", "minLength": 1 },
    "unityVersion": { "type": "string", "minLength": 1 },
    "scriptingBackend": { "enum": ["Mono", "IL2CPP"] },
    "architecture": { "enum": ["Windows-x64", "Windows-arm64", "Linux-x64", "macOS-x64", "macOS-arm64", "other"] },
    "loaderCandidate": { "type": ["string", "null"] },
    "keySourceHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "size", "sha256"],
        "properties": {
          "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/|[A-Za-z]:[\\\\/]).+" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "sourceManifestDigest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "SHA-256 of canonical JSON for the complete source manifest: UTF-8, sorted keys, no insignificant whitespace."
    }
  }
}
